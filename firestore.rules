rules_version = '2';
// Desk snapshot: todo, workspaces, timer, dueMail, moods, productivity
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    // users/{uid}/data/studio — one desk snapshot per signed-in student
    match /users/{userId} {
      allow read, write: if false;

      match /data/{docId} {
        allow read: if signedIn() && request.auth.uid == userId && docId == 'studio';
        allow create, update: if signedIn()
          && request.auth.uid == userId
          && docId == 'studio'
          && isValidStudio();
        allow delete: if signedIn() && request.auth.uid == userId && docId == 'studio';
      }
    }

    function signedIn() {
      return request.auth != null;
    }

    function studioKeys() {
      return request.resource.data.keys().hasAll(['todo', 'workspaces', 'updatedAt', 'timer'])
        && request.resource.data.keys().hasOnly([
          'todo',
          'workspaces',
          'updatedAt',
          'timer',
          'dueMail',
          'moods',
          'productivity',
        ]);
    }

    function isValidStudio() {
      return studioKeys()
        && request.resource.data.todo is list
        && request.resource.data.workspaces is map
        && request.resource.data.updatedAt is number
        && request.resource.data.timer is map
        && isValidTimer()
        && isValidDueMail()
        && isValidEmojiBookField('moods')
        && isValidEmojiBookField('productivity');
    }

    function isValidDueMail() {
      return !('dueMail' in request.resource.data)
        || request.resource.data.dueMail is map;
    }

    function isValidEmojiBookField(name) {
      return !(name in request.resource.data)
        || isValidEmojiBook(request.resource.data[name]);
    }

    function isValidEmojiBook(book) {
      return book is map
        && book.keys().hasOnly(['keys', 'days'])
        && book.get('keys', []) is list
        && book.get('days', {}) is map;
    }

    function isValidTimer() {
      return request.resource.data.timer.keys().hasOnly(['title', 'minutes'])
        && request.resource.data.timer.title is string
        && request.resource.data.timer.title.size() > 0
        && request.resource.data.timer.title.size() <= 40
        && request.resource.data.timer.minutes is number
        && request.resource.data.timer.minutes >= 1
        && request.resource.data.timer.minutes <= 180;
    }
  }
}
