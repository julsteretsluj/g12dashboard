rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    // users/{uid}/data/studio — one desk snapshot per signed-in student
    match /users/{userId} {
      allow read, write: if false;

      match /data/{docId} {
        allow read: if signedIn() && request.auth.uid == userId && docId == 'studio';
        allow create, update: if signedIn()
          && request.auth.uid == userId
          && docId == 'studio'
          && isValidStudio();
        allow delete: if signedIn() && request.auth.uid == userId && docId == 'studio';
      }
    }

    function signedIn() {
      return request.auth != null;
    }

    function isValidStudio() {
      return request.resource.data.keys().hasOnly(['todo', 'workspaces', 'updatedAt'])
        && request.resource.data.todo is list
        && request.resource.data.workspaces is map
        && request.resource.data.updatedAt is number;
    }
  }
}
